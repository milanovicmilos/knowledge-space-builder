# ===== REPRODUCIBILITY & RANDOMNESS =====
# Controls determinism of random operations (numpy, torch, python random)
# Same value = identical results across runs. Change for experiment variations.
RANDOM_SEED=42

# ===== DENOISING AUTOENCODER (DAE) SETTINGS =====
# Number of training epochs through entire dataset
# Higher = better data denoising but slower. 50 is good default.
DAE_EPOCHS=50

# Number of samples per gradient update
# Larger = more stable gradients but more memory. 32 is standard.
DAE_BATCH_SIZE=32

# Learning rate for Adam optimizer
# Higher = faster convergence but risk of divergence. 0.001 is classic.
DAE_LEARNING_RATE=0.001

# Fraction of input to corrupt during training (0.0-1.0)
# Higher = stronger denoising but information loss. 0.1 = 10% noise
DAE_NOISE_FACTOR=0.1

# Threshold for binarizing reconstructed values (0.0-1.0)
# Higher = stricter success criteria. 0.5 = must be > 50%
DAE_DENOISE_THRESHOLD=0.5

# ===== CONCEPT AGGREGATION SETTINGS =====
# Threshold for converting mastery scores to binary (0/1) (0.0-1.0)
# Higher = fewer "mastered" concepts. 0.5 = mastered if >= 50% items correct
CONCEPT_BINARIZE_THRESHOLD=0.5

# ===== IITA & STRUCTURE EXTRACTION SETTINGS =====
# Percentage of average sample size as prerequisite threshold (0.0-1.0)
# Higher = more prerequisites found. 0.05 = 5% = strict selection
IITA_THRESHOLD_RATE=0.05

# Run IITA on concepts (True) or items (False)
# Concept-level = smaller graph but semantically meaningful
# Item-level = detailed but potentially noisy
USE_CONCEPT_LEVEL_IITA=True

# How much semantic similarity affects prerequisite selection (0.0-1.0)
# Higher = dissimilar items harder to skip. 0.3 = moderate weight
SEMANTIC_WEIGHT=0.3

# Minimum cluster size for per-cluster IITA analysis
# Higher = fewer clusters analyzed separately. 5 = reasonable
MIN_CLUSTER_SIZE_IITA=5

# ===== KNOWLEDGE SPACE GENERATION SETTINGS =====
# Maximum states to generate before stopping
# Safety limit to prevent infinite loops. 50000 is safe.
MAX_STATES_LIMIT=50000

# Maximum unobserved state size (number of concepts)
# Higher = more states generated (closer to limit). 8 = moderate
MAX_STATE_SIZE=8

# ===== SEMANTIC & NLP SETTINGS =====
# SentenceTransformer model for semantic similarity
# all-MiniLM-L6-v2 = fast and good. Alternatives: all-mpnet-base-v2 (better but slower)
SEMANTIC_MODEL_NAME=all-MiniLM-L6-v2

# ===== LLM & ONTOLOGY SETTINGS =====
# GitHub API token for LLM access
GITHUB_TOKEN=your_token_here

# Primary LLM model to use
# gpt-4o-mini = free tier. Alternatives: gpt-4o, gpt-4-turbo
LLM_MODEL=gpt-4o-mini

# Comma-separated alternative models (fallback if primary fails)
LLM_ALTERNATIVES=gpt-4o-mini

# Number of clusters per LLM request
# Smaller = slower but more reliable. 5 is balanced.
LLM_BATCH_SIZE=5

# Pause seconds between LLM batches (rate limiting)
# Longer = safer but slower. 2 seconds is reasonable.
LLM_BATCH_PAUSE=2

# Cache file name for LLM responses (stored in output/)
LLM_CACHE_FILE=llm_cache.json
